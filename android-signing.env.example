# Copy this file to "android-signing.env" and fill in your keystore details.
# build-android.sh sources android-signing.env automatically (it is .gitignore'd
# so your credentials are never committed).

export QT_ANDROID_KEYSTORE_PATH="/absolute/path/to/your.keystore"
export QT_ANDROID_KEYSTORE_ALIAS="your_key_alias"
export QT_ANDROID_KEYSTORE_STORE_PASS="your_store_password"
export QT_ANDROID_KEYSTORE_KEY_PASS="your_key_password"
